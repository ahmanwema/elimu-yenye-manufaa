# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# prisma generated client (regenerate with `npm run db:generate`)
/src/generated/

# --- Elimu: secrets & credentials (never commit) ---
*.key
*.p12
*.pfx
*.crt
*.secret
credentials*.json
service-account*.json
.npmrc

# --- Supabase local stack / CLI state ---
/supabase/.branches/
/supabase/.temp/
/supabase/.env
/supabase/volumes/
.supabase/

# --- local databases & test artifacts ---
*.db
*.sqlite
*.sqlite3
/pgdata/
*.log

# --- editor / OS ---
.idea/
Thumbs.db
