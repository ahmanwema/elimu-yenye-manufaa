# TEMPLATE ONLY — this file IS committed to Git. NEVER put real values here.
# Put real values in .env.local (git-ignored), which the app, Prisma and the tests all read.
# Use the DEVELOPMENT Supabase project only (A65). Production access is not authorized.

# Supabase project URL and publishable (client-safe) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key (sb_secret_...). Used ONLY server-side: to create the
# auth account for a validated invitation, and to mint short-lived signed Storage URLs.
# Never put it in any NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=

# Database connections (Supabase → Connect → "Session pooler"; the direct host is IPv6-only).
# Prisma uses a role that bypasses RLS — see docs/system/security.md §2.1.
DATABASE_URL=
DIRECT_URL=

# Canonical public origin used in sign-in emails. Never derived from the request Host header.
SITE_URL=http://localhost:3000
