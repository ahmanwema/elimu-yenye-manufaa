# Pilot-only credentials. Copy to pilot/rtc/.env.local (git-ignored). NEVER commit real values.
# THIS FILE IS A TEMPLATE AND MAY BE COMMITTED — leave every value empty here.
# Use DEVELOPMENT / free-tier provider projects only — never a production account.

# --- LiveKit Cloud (project → Settings → Keys); URL looks like wss://<project>.livekit.cloud ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Agora (Console → project with "Secured mode: APP ID + Token") ---
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# --- Pilot roster: roles are decided HERE on the server, never by the client ---
# Teacher code: a random word only the teacher knows. Student codes: comma-separated.
PILOT_TEACHER_CODE=
PILOT_STUDENT_CODES=
