{
  "name": "elimu-yenye-manufaa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "icons:placeholder": "node scripts/generate-placeholder-icons.mjs",
    "postinstall": "prisma generate",
    "test:dev-supabase": "vitest run --config vitest.real.config.mts",
    "supabase:preflight": "node --env-file=.env.local scripts/dev-supabase-preflight.mjs",
    "db:deploy:dev": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "pglite-prisma-adapter": "0.7.2",
    "prisma": "7.10.0",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
