// Elimu Yenye Manufaa — application schema (Phase 1 foundation).
//
// Identity comes from Supabase Auth. There is deliberately no "users" table here:
// `profiles.id` IS the Supabase `auth.users.id`. The foreign key to `auth.users`
// lives in the Supabase-specific migration (20261013000100_supabase_auth_rls),
// because Prisma does not manage the `auth` schema.
//
// See docs/system/database.md and docs/system/tenancy.md for the reasoning.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per Supabase Auth user. Holds no global tenant role (A28 / BR-01).
model Profile {
  /// Equals auth.users.id. Never generated by the application.
  id          String   @id @db.Uuid
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  platformAdmin                PlatformAdmin?
  memberships                  Membership[]
  studentAccount               StudentAccount?
  parentAccount                ParentAccount?
  permissionGrants             TenantPermissionGrant[]
  adminAppointmentsAsCandidate MarkazAdminAppointmentRequest[]
  correctionsAuthored          Correction[]                    @relation("CorrectionTeacher")
  clipsCreated                 CorrectionAudioClip[]           @relation("ClipCreator")
  recordingsAuthored           Recording[]                     @relation("RecordingTeacher")

  @@map("profiles")
}

/// The only GLOBAL role. Presence of a row = Super Admin.
/// Kept in its own table (not a column on profiles) so no profile-update path can grant it.
model PlatformAdmin {
  profileId String   @id @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

/// A Markaz. Every tenant-scoped table resolves to a tenant_id.
/// (Independent-teacher tenants from tenancy.md §1 are not modelled yet — not approved.)
model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships          Membership[]
  parentStudentLinks   ParentStudentLink[]
  permissionGrants     TenantPermissionGrant[]
  invitations          Invitation[]
  adminAppointments    MarkazAdminAppointmentRequest[]
  corrections          Correction[]
  recordings           Recording[]
  offlineConsents      RecordingConsent[]
  deletionRequests     MediaDeletionRequest[]
  recordingEntitlement RecordingEntitlement?

  @@map("tenants")
}

/// Roles that only exist inside a tenant. SUPER_ADMIN is global (PlatformAdmin);
/// PARENT is an account type + link, not a tenant role (A27).
enum TenantRole {
  MARKAZ_ADMIN
  TEACHER
  STUDENT
}

/// ENDED keeps the row for history (departed students keep their own records, A32).
enum MembershipStatus {
  ACTIVE
  ENDED
}

/// One row per (tenant, profile, role). A Teacher in two Markaz has two rows (A28).
/// A person may hold more than one role in the same Markaz (e.g. admin + teacher).
model Membership {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  profileId          String           @map("profile_id") @db.Uuid
  role               TenantRole
  status             MembershipStatus @default(ACTIVE)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  endedAt            DateTime?        @map("ended_at") @db.Timestamptz(6)
  /// STUDENT memberships only: the student's registration number in THIS Markaz.
  /// Assigned once by a database trigger (app.assign_registration_number), never changed,
  /// unique per Markaz. Used by a parent's self-request (A64). Not a secret, not a credential.
  registrationNumber String?          @map("registration_number")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([tenantId, profileId, role])
  @@unique([tenantId, registrationNumber])
  @@index([profileId])
  @@map("memberships")
}

/// Student account type. Personal academic records (submissions, corrections — later
/// phases) will reference this, NOT a membership, so leaving a Markaz cannot orphan them (A32).
model StudentAccount {
  profileId               String    @id @map("profile_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Recording-consent policy input. Minor/adult status is ALWAYS derived from this date
  /// (src/server/authz/recording-consent.ts) — there is deliberately no stored is_minor flag.
  dateOfBirth             DateTime? @map("date_of_birth") @db.Date
  /// Entered by the student or an ACTIVE guardian (A82).
  dateOfBirthEnteredById  String?   @map("date_of_birth_entered_by_id") @db.Uuid
  dateOfBirthEnteredAt    DateTime? @map("date_of_birth_entered_at") @db.Timestamptz(6)
  /// Verified by a Markaz Admin (A82). Until set, the DOB is NOT trusted: recording
  /// eligibility fails closed. Re-entering the DOB clears the verification.
  dateOfBirthVerifiedById String?   @map("date_of_birth_verified_by_id") @db.Uuid
  dateOfBirthVerifiedAt   DateTime? @map("date_of_birth_verified_at") @db.Timestamptz(6)

  profile               Profile                @relation(fields: [profileId], references: [id], onDelete: Cascade)
  parentLinks           ParentStudentLink[]
  corrections           Correction[]
  recordingConsents     RecordingConsent[]
  recordingParticipants RecordingParticipant[]

  @@map("student_accounts")
}

/// Parent account type (A27). Separate from Student; not a viewer flag.
model ParentAccount {
  profileId String   @id @map("profile_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile       Profile             @relation(fields: [profileId], references: [id], onDelete: Cascade)
  studentLinks  ParentStudentLink[]
  givenConsents RecordingConsent[]

  @@map("parent_accounts")
}

/// Only ACTIVE grants a Parent access to child data. Who moves a link between
/// states is an open owner decision (open question 14) — no transition logic exists yet.
enum ParentStudentLinkStatus {
  PENDING
  VERIFIED
  ACTIVE
  REVOKED
}

model ParentStudentLink {
  id                String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentProfileId   String                  @map("parent_profile_id") @db.Uuid
  studentProfileId  String                  @map("student_profile_id") @db.Uuid
  /// The Markaz in which this relationship is verified (A46). Verification authority is
  /// scoped to this tenant only.
  tenantId          String                  @map("tenant_id") @db.Uuid
  status            ParentStudentLinkStatus @default(PENDING)
  /// Audit only: records who changed the status. Does not define who is allowed to.
  statusChangedById String?                 @map("status_changed_by_id") @db.Uuid
  statusChangedAt   DateTime                @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  /// Who started the current request cycle (A56): the parent themself, or staff.
  initiatedBy       ParentLinkInitiator     @default(PARENT) @map("initiated_by")
  requestedById     String?                 @map("requested_by_id") @db.Uuid
  requestedAt       DateTime                @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// PENDING → VERIFIED (A46).
  verifiedById      String?                 @map("verified_by_id") @db.Uuid
  verifiedAt        DateTime?               @map("verified_at") @db.Timestamptz(6)
  /// VERIFIED → ACTIVE (A55).
  activatedById     String?                 @map("activated_by_id") @db.Uuid
  activatedAt       DateTime?               @map("activated_at") @db.Timestamptz(6)
  /// → REVOKED, by the parent or authorized staff (A57).
  revokedById       String?                 @map("revoked_by_id") @db.Uuid
  revokedAt         DateTime?               @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  parent  ParentAccount     @relation(fields: [parentProfileId], references: [profileId], onDelete: Cascade)
  student StudentAccount    @relation(fields: [studentProfileId], references: [profileId], onDelete: Cascade)
  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  events  ParentLinkEvent[]

  @@unique([parentProfileId, studentProfileId])
  @@index([studentProfileId])
  @@index([tenantId, status])
  @@map("parent_student_links")
}

/// Permissions that are never implied by a role and must be granted explicitly,
/// per Markaz (A47). Effective only while the holder also has an eligible ACTIVE role
/// in that Markaz (see src/server/authz/policy.ts GRANTABLE_PERMISSION_ROLES).
enum TenantPermission {
  PARENT_LINK_VERIFY
  PARENT_LINK_CREATE
  PARENT_LINK_ACTIVATE
  PARENT_LINK_REVOKE
  INVITATION_CREATE
}

enum ParentLinkInitiator {
  PARENT
  STAFF
}

/// Append-only history of every parent-link state change (the link row keeps only the
/// current cycle, because a REVOKED link may be requested again).
model ParentLinkEvent {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  linkId     String                   @map("link_id") @db.Uuid
  fromStatus ParentStudentLinkStatus? @map("from_status")
  toStatus   ParentStudentLinkStatus  @map("to_status")
  actorId    String                   @map("actor_id") @db.Uuid
  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)

  link ParentStudentLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@map("parent_link_events")
}

model TenantPermissionGrant {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  profileId   String           @map("profile_id") @db.Uuid
  permission  TenantPermission
  grantedById String           @map("granted_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Revocation keeps the row for audit. At most one un-revoked grant per
  /// (tenant, profile, permission) — enforced by a partial unique index in SQL.
  revokedAt   DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedById String?          @map("revoked_by_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("tenant_permission_grants")
}

/// What accepting the invitation creates: a tenant membership (role) or a Parent account (A61).
enum InvitationKind {
  MEMBERSHIP
  PARENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Invite-first onboarding (A45). The raw token is shown once to the inviter and never
/// stored — only its SHA-256 hash. Tenant, role and email come from this row on
/// acceptance, never from the recipient's input.
model Invitation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash         String           @unique @map("token_hash")
  /// Normalized (trimmed, lower-case). Acceptance requires a session for this email.
  email             String
  tenantId          String           @map("tenant_id") @db.Uuid
  kind              InvitationKind   @default(MEMBERSHIP)
  /// Required for MEMBERSHIP, null for PARENT (CHECK in SQL).
  role              TenantRole?
  /// PARENT only, optional: the student this parent should be linked to. On acceptance
  /// it becomes a PENDING link request — never access (A61).
  proposedStudentId String?          @map("proposed_student_id") @db.Uuid
  status            InvitationStatus @default(PENDING)
  invitedById       String           @map("invited_by_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime?        @map("accepted_at") @db.Timestamptz(6)
  acceptedById      String?          @map("accepted_by_id") @db.Uuid
  revokedAt         DateTime?        @map("revoked_at") @db.Timestamptz(6)
  revokedById       String?          @map("revoked_by_id") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("invitations")
}

enum AppointmentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A Markaz Admin may request (not grant) another Markaz Admin; only a Super Admin
/// may approve or reject (A52).
model MarkazAdminAppointmentRequest {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  candidateProfileId String                   @map("candidate_profile_id") @db.Uuid
  requestedById      String                   @map("requested_by_id") @db.Uuid
  status             AppointmentRequestStatus @default(PENDING)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedById       String?                  @map("reviewed_by_id") @db.Uuid
  reviewedAt         DateTime?                @map("reviewed_at") @db.Timestamptz(6)

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  candidate Profile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("markaz_admin_appointment_requests")
}

// =====================================================================================
// Recording & correction media (owner decisions 2026-10-14, A66–A80).
// Provider-neutral: nothing here knows about an RTC vendor (A35 still open).
// =====================================================================================

/// Option B correction (A29, A66): annotation + note/context + timestamp + short clip(s).
/// References student_accounts (not a membership) so it survives the student leaving (A32).
/// Corrections are academic history: there is no delete path; media is restricted/purged
/// separately (A75) while this row and its anchors remain.
model Correction {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  studentProfileId String   @map("student_profile_id") @db.Uuid
  teacherProfileId String   @map("teacher_profile_id") @db.Uuid
  /// The correction timestamp (when, in the lesson, the mistake was marked).
  capturedAt       DateTime @map("captured_at") @db.Timestamptz(6)
  /// Content-neutral annotation (marks/geometry) as produced by the future annotation UI.
  annotation       Json?
  /// Teacher's explanatory note / private correction context.
  note             String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  student    StudentAccount        @relation(fields: [studentProfileId], references: [profileId], onDelete: Restrict)
  teacher    Profile               @relation("CorrectionTeacher", fields: [teacherProfileId], references: [id], onDelete: Restrict)
  audioClips CorrectionAudioClip[]
  anchors    CorrectionAnchor[]

  @@unique([id, tenantId])
  @@index([studentProfileId])
  @@index([tenantId])
  @@map("corrections")
}

/// Which content context a correction refers to (A67). Lesson/page/chunk models do not
/// exist yet, so `ref_id` is an opaque identifier with NO foreign key; the snapshot keeps
/// the correction understandable after the source content is removed (A76).
enum CorrectionAnchorKind {
  LESSON
  PAGE
  CHUNK
  SEGMENT
  TIMESTAMP
}

model CorrectionAnchor {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionId    String               @map("correction_id") @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  kind            CorrectionAnchorKind
  /// Identifier of the referenced content entity, when one exists. Not a foreign key.
  refId           String?              @map("ref_id")
  /// Where inside that content: e.g. { page: 12 }, { chunkIndex: 3 }, { startMs, endMs }.
  position        Json?
  /// Historical snapshot (title, excerpt, page label…). Required; never cleared.
  snapshot        Json
  /// Set when the referenced content is removed. The anchor and correction remain.
  sourceRemovedAt DateTime?            @map("source_removed_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  correction Correction @relation(fields: [correctionId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([correctionId])
  @@index([kind, refId])
  @@map("correction_anchors")
}

enum ClipSourceType {
  /// Short clip captured directly for the correction (no full recording needed).
  DIRECT_CAPTURE
  /// Segment copied out of a full-session (Option C) recording.
  EXTRACTED_FROM_RECORDING
}

enum ClipStatus {
  AWAITING_UPLOAD
  AWAITING_EXTRACTION
  FINALIZED
  /// Never finalized (abandoned upload cleanup, or the object failed validation).
  FAILED
}

/// Correction audio is ALWAYS its own storage object (A53). Provenance fields record where
/// an extracted clip came from but are never needed for playback; deleting or detaching
/// the source recording leaves a finalized clip intact (FK ON DELETE SET NULL).
/// Several clips per correction; exactly one live FINALIZED clip is primary (A68).
model CorrectionAudioClip {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  correctionId      String         @map("correction_id") @db.Uuid
  /// Copied from the correction and pinned to it by a composite FK.
  tenantId          String         @map("tenant_id") @db.Uuid
  sourceType        ClipSourceType @map("source_type")
  /// Provenance only, validated against recordings (same Markaz) at registration.
  sourceRecordingId String?        @map("source_recording_id") @db.Uuid
  sourceStartMs     Int?           @map("source_start_ms")
  sourceEndMs       Int?           @map("source_end_ms")
  status            ClipStatus
  /// Server-generated, non-guessable, unique. Assigned at registration.
  storageBucket     String         @map("storage_bucket")
  storageObjectKey  String         @unique @map("storage_object_key")
  /// FINALIZED clips: always "audio/mp4" (AAC in M4A, A69), set by the server after it
  /// inspected the stored object.
  mimeType          String?        @map("mime_type")
  byteSize          Int?           @map("byte_size")
  /// FINALIZED clips: measured by the server from the stored M4A, ≤ 60 000 ms (A69).
  durationMs        Int?           @map("duration_ms")
  createdById       String         @map("created_by_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  finalizedAt       DateTime?      @map("finalized_at") @db.Timestamptz(6)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(6)
  /// The current clip of its correction. Older clips stay as history (A68).
  isPrimary         Boolean        @default(false) @map("is_primary")
  /// Deletion lifecycle (A73–A75): approved → soft-deleted + archived; bytes purged after
  /// purge_eligible_at; this row (metadata/history) is never removed.
  deletedAt         DateTime?      @map("deleted_at") @db.Timestamptz(6)
  archivedAt        DateTime?      @map("archived_at") @db.Timestamptz(6)
  purgeEligibleAt   DateTime?      @map("purge_eligible_at") @db.Timestamptz(6)
  purgedAt          DateTime?      @map("purged_at") @db.Timestamptz(6)

  correction       Correction             @relation(fields: [correctionId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy        Profile                @relation("ClipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sourceRecording  Recording?             @relation(fields: [sourceRecordingId], references: [id], onDelete: SetNull)
  deletionRequests MediaDeletionRequest[]

  @@index([correctionId])
  @@index([sourceRecordingId])
  @@map("correction_audio_clips")
}

// --- Consent / minors (A70–A72) --------------------------------------------------------

enum RecordingConsentMethod {
  /// Given online by a guardian holding an ACTIVE parent link to the student.
  GUARDIAN_ONLINE
  /// Recorded by a Markaz Admin after verifying offline evidence (A71).
  OFFLINE_VERIFIED
  /// An ADULT student's own consent, given in their account/enrollment flow (A83).
  SELF_ONLINE
}

/// One consent policy covers correction clips AND full recordings (A72). Rows are never
/// deleted; withdrawal sets withdrawn_at and keeps the audit trail.
model RecordingConsent {
  id                          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentProfileId            String                 @map("student_profile_id") @db.Uuid
  method                      RecordingConsentMethod
  /// OFFLINE_VERIFIED: the Markaz whose admin verified it (applies there only).
  /// GUARDIAN_ONLINE: null (the guardian's consent applies wherever the child studies).
  tenantId                    String?                @map("tenant_id") @db.Uuid
  /// GUARDIAN_ONLINE: the consenting guardian.
  guardianProfileId           String?                @map("guardian_profile_id") @db.Uuid
  /// OFFLINE_VERIFIED: who gave consent (e.g. "mother — name"), short text.
  offlineConsenterDescription String?                @map("offline_consenter_description")
  /// OFFLINE_VERIFIED: a reference to the evidence checked (e.g. a form number) — never
  /// the evidence itself.
  evidenceReference           String?                @map("evidence_reference")
  /// Who recorded the row: the guardian (online) or the verifying Markaz Admin (offline).
  recordedById                String                 @map("recorded_by_id") @db.Uuid
  grantedAt                   DateTime               @map("granted_at") @db.Timestamptz(6)
  withdrawnAt                 DateTime?              @map("withdrawn_at") @db.Timestamptz(6)
  withdrawnById               String?                @map("withdrawn_by_id") @db.Uuid
  createdAt                   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  student          StudentAccount         @relation(fields: [studentProfileId], references: [profileId], onDelete: Restrict)
  tenant           Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  guardian         ParentAccount?         @relation(fields: [guardianProfileId], references: [profileId], onDelete: Restrict)
  participations   RecordingParticipant[]
  deletionRequests MediaDeletionRequest[]

  @@index([studentProfileId])
  @@map("recording_consents")
}

// --- Full recordings (Option C foundation, provider-neutral — A77–A80) ------------------

enum RecordingStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  /// Approval revoked by a Markaz Admin. Not deletion (A79). The teacher may resubmit (A87).
  REVOKED
  /// Returned by a Markaz Admin during review. The teacher may fix and resubmit (A87).
  REJECTED
}

enum RecordingApprovalScope {
  /// Default: the whole recording is approved.
  WHOLE
  /// Special case: only the approved segments are visible to parents.
  SEGMENTS
}

model Recording {
  id                            String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                      String                  @map("tenant_id") @db.Uuid
  /// The teacher who owns the teaching workflow (author).
  teacherProfileId              String                  @map("teacher_profile_id") @db.Uuid
  title                         String?
  status                        RecordingStatus         @default(DRAFT)
  /// A30: the recording-start notice must be shown; set when capture starts.
  noticeShownAt                 DateTime?               @map("notice_shown_at") @db.Timestamptz(6)
  /// A89: the teacher's OWN recording notice acknowledgement — distinct from, and never a
  /// substitute for, student/guardian consent.
  teacherNoticeAcknowledgedAt   DateTime?               @map("teacher_notice_acknowledged_at") @db.Timestamptz(6)
  teacherNoticeAcknowledgedById String?                 @map("teacher_notice_acknowledged_by_id") @db.Uuid
  startedAt                     DateTime?               @map("started_at") @db.Timestamptz(6)
  endedAt                       DateTime?               @map("ended_at") @db.Timestamptz(6)
  /// Media object (written by a future, provider-neutral capture/egress worker).
  storageBucket                 String?                 @map("storage_bucket")
  storageObjectKey              String?                 @unique @map("storage_object_key")
  mimeType                      String?                 @map("mime_type")
  byteSize                      Int?                    @map("byte_size")
  durationMs                    Int?                    @map("duration_ms")
  mediaFinalizedAt              DateTime?               @map("media_finalized_at") @db.Timestamptz(6)
  submittedAt                   DateTime?               @map("submitted_at") @db.Timestamptz(6)
  submittedById                 String?                 @map("submitted_by_id") @db.Uuid
  approvalScope                 RecordingApprovalScope? @map("approval_scope")
  approvedAt                    DateTime?               @map("approved_at") @db.Timestamptz(6)
  approvedById                  String?                 @map("approved_by_id") @db.Uuid
  approvalRevokedAt             DateTime?               @map("approval_revoked_at") @db.Timestamptz(6)
  approvalRevokedById           String?                 @map("approval_revoked_by_id") @db.Uuid
  rejectedAt                    DateTime?               @map("rejected_at") @db.Timestamptz(6)
  rejectedById                  String?                 @map("rejected_by_id") @db.Uuid
  /// Optional explanation for the teacher.
  rejectionReason               String?                 @map("rejection_reason")
  deletedAt                     DateTime?               @map("deleted_at") @db.Timestamptz(6)
  archivedAt                    DateTime?               @map("archived_at") @db.Timestamptz(6)
  purgeEligibleAt               DateTime?               @map("purge_eligible_at") @db.Timestamptz(6)
  purgedAt                      DateTime?               @map("purged_at") @db.Timestamptz(6)
  createdAt                     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  teacher          Profile                @relation("RecordingTeacher", fields: [teacherProfileId], references: [id], onDelete: Restrict)
  participants     RecordingParticipant[]
  segments         RecordingSegment[]
  extractedClips   CorrectionAudioClip[]
  deletionRequests MediaDeletionRequest[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@map("recordings")
}

/// Why a participant's audio may or may not be included in recorded media. Live
/// participation (joining, listening, a live mic grant) never depends on this (A72).
enum RecordingEligibility {
  CONSENTED
  NO_CONSENT
  DATE_OF_BIRTH_MISSING
  /// A82: entered but not yet verified by a Markaz Admin.
  DATE_OF_BIRTH_UNVERIFIED
  /// LEGACY (2026-10-14 interim, no longer produced — A81 set the threshold).
  AGE_POLICY_UNSET
  /// LEGACY (2026-10-14 interim, no longer produced — A83 defined adult consent).
  ADULT_CONSENT_UNDECIDED
}

model RecordingParticipant {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId      String               @map("recording_id") @db.Uuid
  tenantId         String               @map("tenant_id") @db.Uuid
  studentProfileId String               @map("student_profile_id") @db.Uuid
  /// The capture boundary a future provider adapter must honor: false → this student's
  /// audio must not be included in recorded media.
  audioIncluded    Boolean              @map("audio_included")
  eligibility      RecordingEligibility
  consentId        String?              @map("consent_id") @db.Uuid
  registeredAt     DateTime             @default(now()) @map("registered_at") @db.Timestamptz(6)

  recording Recording         @relation(fields: [recordingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  student   StudentAccount    @relation(fields: [studentProfileId], references: [profileId], onDelete: Restrict)
  consent   RecordingConsent? @relation(fields: [consentId], references: [id], onDelete: Restrict)

  @@unique([recordingId, studentProfileId])
  @@index([studentProfileId])
  @@map("recording_participants")
}

/// Special-case segment approval (A78). A segment is playable only through its OWN media
/// object (copied by a future extraction worker) — never as a byte range of the recording.
model RecordingSegment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recordingId      String    @map("recording_id") @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  startMs          Int       @map("start_ms")
  endMs            Int       @map("end_ms")
  approvedAt       DateTime  @map("approved_at") @db.Timestamptz(6)
  approvedById     String    @map("approved_by_id") @db.Uuid
  storageBucket    String?   @map("storage_bucket")
  storageObjectKey String?   @unique @map("storage_object_key")
  byteSize         Int?      @map("byte_size")
  mediaFinalizedAt DateTime? @map("media_finalized_at") @db.Timestamptz(6)
  purgedAt         DateTime? @map("purged_at") @db.Timestamptz(6)
  /// Set when the approval this segment belonged to is revoked; a withdrawn segment is never
  /// shown to parents again (a re-approval creates new segments).
  withdrawnAt      DateTime? @map("withdrawn_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recording Recording @relation(fields: [recordingId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([recordingId])
  @@map("recording_segments")
}

// --- Retention / deletion (A73–A75) ----------------------------------------------------

enum MediaDeletionReason {
  REQUESTED
  /// Created automatically when consent is withdrawn (A72): media enters review.
  CONSENT_WITHDRAWN
}

enum MediaDeletionStatus {
  PENDING
  APPROVED
  /// Declined by a Markaz Admin (A85). Media untouched.
  DECLINED
  /// Cancelled by the requester before approval (A85). Media untouched.
  CANCELLED
}

/// REQUEST → MARKAZ ADMIN APPROVAL → soft delete + archive → 30-day grace → purge.
/// Exactly one target (a clip or a recording).
model MediaDeletionRequest {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  clipId        String?             @map("clip_id") @db.Uuid
  recordingId   String?             @map("recording_id") @db.Uuid
  reason        MediaDeletionReason
  consentId     String?             @map("consent_id") @db.Uuid
  status        MediaDeletionStatus @default(PENDING)
  requestedById String              @map("requested_by_id") @db.Uuid
  requestedAt   DateTime            @map("requested_at") @db.Timestamptz(6)
  note          String?
  /// Never the requester (A84; also a DB CHECK).
  approvedById  String?             @map("approved_by_id") @db.Uuid
  approvedAt    DateTime?           @map("approved_at") @db.Timestamptz(6)
  declinedById  String?             @map("declined_by_id") @db.Uuid
  declinedAt    DateTime?           @map("declined_at") @db.Timestamptz(6)
  /// Optional explanation from the declining admin.
  declineReason String?             @map("decline_reason")
  cancelledById String?             @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?           @map("cancelled_at") @db.Timestamptz(6)

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  clip      CorrectionAudioClip? @relation(fields: [clipId], references: [id], onDelete: Restrict)
  recording Recording?           @relation(fields: [recordingId], references: [id], onDelete: Restrict)
  consent   RecordingConsent?    @relation(fields: [consentId], references: [id], onDelete: Restrict)

  @@index([tenantId, status])
  @@map("media_deletion_requests")
}

// --- Audit (A80) -----------------------------------------------------------------------

enum AuditAction {
  SUPER_ADMIN_MEDIA_READ
  RECORDING_SUBMITTED
  RECORDING_APPROVED
  RECORDING_APPROVAL_REVOKED
  MEDIA_DELETION_REQUESTED
  MEDIA_DELETION_APPROVED
  MEDIA_PURGED
  CONSENT_GIVEN
  CONSENT_OFFLINE_VERIFIED
  CONSENT_WITHDRAWN
  DATE_OF_BIRTH_RECORDED
  CORRECTION_CLIP_REPLACED
  DATE_OF_BIRTH_VERIFIED
  MEDIA_DELETION_CANCELLED
  MEDIA_DELETION_DECLINED
  ABANDONED_UPLOAD_CLEANED
  RECORDING_REJECTED
  RECORDING_RESUBMITTED
  CORRECTION_CLIP_PROMOTED
  RECORDING_TEACHER_NOTICE_ACKNOWLEDGED
  OPTION_C_REQUESTED
  OPTION_C_ENABLED
  OPTION_C_CANCELLED
  OPTION_C_DECLINED
  OPTION_C_DISABLED
}

enum AuditTargetType {
  CORRECTION
  CORRECTION_AUDIO_CLIP
  RECORDING
  RECORDING_SEGMENT
  MEDIA_DELETION_REQUEST
  RECORDING_CONSENT
  STUDENT_ACCOUNT
  RECORDING_ENTITLEMENT
}

/// Append-only (UPDATE/DELETE refused by a trigger). Never holds signed URLs, object keys
/// or secrets. actor_id is null for system jobs (e.g. the purge).
model AuditEvent {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?         @map("actor_id") @db.Uuid
  tenantId   String?         @map("tenant_id") @db.Uuid
  action     AuditAction
  targetType AuditTargetType @map("target_type")
  targetId   String          @map("target_id") @db.Uuid
  metadata   Json?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_events")
}

// --- Option C entitlement (A90) --------------------------------------------------------

/// Feature entitlement only — no pricing, billing or payment (A34/A44 commercial terms open).
enum RecordingEntitlementStatus {
  /// Option C (full recording) is not available to this Markaz.
  NOT_ENABLED
  /// A Markaz Admin requested it; waiting for a Super Admin.
  PENDING
  /// A Super Admin approved/enabled it.
  ENABLED
  /// A Super Admin declined the pending request (A96).
  DECLINED
  /// The requesting Markaz Admin cancelled their pending request (A96).
  CANCELLED
  /// A Super Admin disabled it after it was enabled (A96). History/media are kept.
  DISABLED
}

/// One row per Markaz holding the CURRENT request cycle (A90, A96):
///   NOT_ENABLED / DECLINED / CANCELLED / DISABLED ──request (Markaz Admin)──▶ PENDING
///   PENDING ──enable (Super Admin)──▶ ENABLED ──disable (Super Admin)──▶ DISABLED
///   PENDING ──decline (Super Admin)──▶ DECLINED;  PENDING ──cancel (requester)──▶ CANCELLED
/// No row = NOT_ENABLED. A teacher can never request or enable it. Full history: audit_events.
model RecordingEntitlement {
  tenantId      String                     @id @map("tenant_id") @db.Uuid
  status        RecordingEntitlementStatus @default(NOT_ENABLED)
  requestedById String?                    @map("requested_by_id") @db.Uuid
  requestedAt   DateTime?                  @map("requested_at") @db.Timestamptz(6)
  enabledById   String?                    @map("enabled_by_id") @db.Uuid
  enabledAt     DateTime?                  @map("enabled_at") @db.Timestamptz(6)
  declinedById  String?                    @map("declined_by_id") @db.Uuid
  declinedAt    DateTime?                  @map("declined_at") @db.Timestamptz(6)
  cancelledById String?                    @map("cancelled_by_id") @db.Uuid
  cancelledAt   DateTime?                  @map("cancelled_at") @db.Timestamptz(6)
  disabledById  String?                    @map("disabled_by_id") @db.Uuid
  disabledAt    DateTime?                  @map("disabled_at") @db.Timestamptz(6)
  updatedAt     DateTime                   @default(now()) @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("recording_entitlements")
}
